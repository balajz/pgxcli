#!/bin/bash
set -e

print_help() {
  cat <<EOF
Build pgxcli binaries locally with goreleaser:
  script/release --local [--platform {linux|macos|windows}] [<tag-name>]
EOF
}

if [ $# -eq 0 ]; then
  print_help >&2
  exit 1
fi

tag_name=""
platform=""

while [ $# -gt 0 ]; do
  case "$1" in
  -h | --help )
    print_help
    exit 0
    ;;
  -p | --platform )
    platform="$2"
    shift 2
    ;;
  --local )
    shift 1
    ;;
  -* )
    printf "unrecognized flag: %s\n" "$1" >&2
    exit 1
    ;;
  * )
    tag_name="$1"
    shift 1
    ;;
  esac
done

goreleaser_config=".goreleaser.yaml"

filter_goreleaser_config() {
  local build_id="$1"
  local output_file="$2"

  awk -v selected_build="$build_id" '
    /^builds:/ {
      in_builds = 1
      print
      next
    }
    in_builds && /^[^[:space:]]/ {
      in_builds = 0
      keep_build = 1
      print
      next
    }
    in_builds && /^  - id: / {
      keep_build = ($3 == selected_build)
      if (keep_build) print
      next
    }
    in_builds && !keep_build { next }
    { print }
  ' .goreleaser.yaml >"$output_file"
}

case "$platform" in
linux )
  filter_goreleaser_config linux .goreleaser.generated.yaml
  goreleaser_config=".goreleaser.generated.yaml"
  ;;
macos )
  filter_goreleaser_config darwin .goreleaser.generated.yaml
  goreleaser_config=".goreleaser.generated.yaml"
  ;;
windows )
  filter_goreleaser_config windows .goreleaser.generated.yaml
  goreleaser_config=".goreleaser.generated.yaml"
  ;;
esac

[ -z "$tag_name" ] || export GORELEASER_CURRENT_TAG="$tag_name"

goreleaser release -f "$goreleaser_config" --clean --skip validate,publish,announce
